{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "Easy-to-use book for coordinates storage.",
  "authors": [
    "${author}"
  ],
  "contact": {
    "sources": "${repoUrl}"
  },
  "license": "MIT",
  "icon": "assets/rpgmod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.marshmallow.rpgmod.RpgMod"
    ]
  },
  "mixins": [
    "rpgmod.mixins.json"
  ],
  "depends": {
    "java": ">=${minJavaVersion}",
    "minecraft": ">=${minMinecraftVersion}",
    "fabricloader": ">=${minLoaderVersion}"
  },
  "accessWidener": "rpgmod.accesswidener"
}
